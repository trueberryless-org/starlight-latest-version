---
import { Badge } from "@astrojs/starlight/components";
import config from "virtual:starlight-latest-version/config";

import {
  getCachedLatestVersion,
  getLatestReleasePageUrl,
  getLatestVersion,
} from "../libs/release";
import { getVersionLabel } from "../libs/version";

interface Props {
  useCache?: boolean;
}

const { useCache = false } = Astro.props;

const version = useCache
  ? await getCachedLatestVersion(Astro.session)
  : await getLatestVersion();
const label = getVersionLabel(
  version,
  Astro.locals.t("starlightLatestVersion.unavailable")
);
const href = getLatestReleasePageUrl();
---

<starlight-latest-version>
  <a href={href} id="starlight-latest-version-link">
    <Badge
      text={label}
      variant={config.badge.variant}
      size={config.badge.size}
      id="starlight-latest-version-badge"
    />
  </a>
</starlight-latest-version>

<style>
  starlight-latest-version {
    flex-shrink: 0;
  }

  #starlight-latest-version-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
